DISCORD_TOKEN=
CALLIOPE_ENCRYPTION_KEY=

# Railway volume mount. Attach a volume at /data.
CALLIOPE_DB_PATH=/data/calliope.db

# OpenAI-compatible chat-completions endpoint for your own/self-hosted LLM.
# Example base URL: https://your-llm.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

SUMMARY_INTERVAL_HOURS=6
SUMMARY_MIN_MESSAGES=3
SUGGEST_HISTORY_LIMIT=50

# Sunday weekly chronicle generation time, in UTC (0-23).
SUNDAY_SUMMARY_HOUR_UTC=23
